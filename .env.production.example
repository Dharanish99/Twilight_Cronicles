# Twilight Chronicles - Production Environment Configuration

# -------------------------------------------------------------
# 1. FRONTEND (Vercel) Environment Variables
# -------------------------------------------------------------
# Set these in your Vercel Project Settings -> Environment Variables:
NEXT_PUBLIC_REALTIME_URL=https://your-realtime-app.onrender.com
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app

# -------------------------------------------------------------
# 2. BACKEND (Render / Railway / Koyeb) Environment Variables
# -------------------------------------------------------------
# Set these in your Render Web Service -> Environment Variables:
PORT=10000
NODE_ENV=production
WEB_ORIGIN=https://your-frontend.vercel.app
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# -------------------------------------------------------------
# 3. REDIS (Upstash - Free Serverless Redis)
# -------------------------------------------------------------
# Create a free Redis DB at https://console.upstash.com
# Copy the "Node.js ioredis" / "redis-cli" connection URL and paste into REDIS_URL above.
