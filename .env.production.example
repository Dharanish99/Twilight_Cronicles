# Frontend build environment (copy into apps/web/.env.local)
NEXT_PUBLIC_REALTIME_URL=https://your-realtime-service.example.com

# Realtime service environment
PORT=10000
NODE_ENV=production
WEB_ORIGIN=https://your-frontend.example.com
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_PRIVATE_REDIS_HOST:6379
# Enable only when requests arrive through a trusted ingress that sets X-Forwarded-For.
TRUST_PROXY=true
