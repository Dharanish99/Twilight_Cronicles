# Twilight Chronicles — Environment Variables

# Database
DATABASE_URL="postgresql://twilight:twilight_local@localhost:5432/twilight_chronicles"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Encryption key for Highlights (AES-256-GCM, 32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HIGHLIGHT_ENCRYPTION_KEY="REPLACE_WITH_GENERATED_KEY"

# Socket.IO auth secret (for session tokens)
SESSION_TOKEN_SECRET="REPLACE_WITH_GENERATED_SECRET"

# NextAuth (Phase 7, optional)
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
NEXTAUTH_URL="http://localhost:3000"
