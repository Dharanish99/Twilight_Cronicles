# Development defaults for the realtime service
REDIS_URL=redis://localhost:6379
# Optional locally; set a long random value in production so pair question
# history is keyed by an opaque deployment-specific HMAC.
PAIR_HISTORY_SECRET=replace-with-a-local-development-secret
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Browser build settings (copy into apps/web/.env.local)
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
